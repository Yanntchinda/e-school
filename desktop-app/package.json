{
  "name": "e-school-gestion-bulletins",
  "version": "1.0.0",
  "description": "Application de gestion des bulletins scolaires - Ming's Bilingual Institute",
  "main": "main.js",
  "author": "Yanntchinda e-school",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mw"
  },
  "build": {
    "appId": "com.eschool.bulletins",
    "productName": "e-School Gestion Bulletins",
    "directories": {
      "output": "dist/installers"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "e-School Bulletins"
    },
    "mac": {
      "target": "dmg",
      "icon": "app/icon.icns",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "app/icon.png",
      "category": "Education"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
