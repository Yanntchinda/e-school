<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"><Styles><Style ss:ID="head"><Font ss:Bold="1" ss:Color="#FFFFFF"/><Interior ss:Color="#1F4E79" ss:Pattern="Solid"/></Style><Style ss:ID="hint"><Font ss:Italic="1" ss:Color="#6B7280"/></Style></Styles><Worksheet ss:Name="Eleves"><Table><Column ss:AutoFitWidth="0" ss:Width="230"/><Column ss:AutoFitWidth="0" ss:Width="60"/><Column ss:AutoFitWidth="0" ss:Width="105"/><Column ss:AutoFitWidth="0" ss:Width="130"/><Column ss:AutoFitWidth="0" ss:Width="200"/><Column ss:AutoFitWidth="0" ss:Width="100"/><Column ss:AutoFitWidth="0" ss:Width="120"/><Column ss:AutoFitWidth="0" ss:Width="190"/><Column ss:AutoFitWidth="0" ss:Width="150"/><Row><Cell ss:StyleID="head"><Data ss:Type="String">NOM ET PRÉNOMS</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">SEXE</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">DATE DE NAISSANCE</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">LIEU DE NAISSANCE</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">NOM DU PARENT / TUTEUR</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">LIEN DE PARENTÉ</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">TÉLÉPHONE DU PARENT</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">E-MAIL DU PARENT</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">MATRICULE (laisser vide)</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Exemple"><Table><Column ss:AutoFitWidth="0" ss:Width="230"/><Column ss:AutoFitWidth="0" ss:Width="60"/><Column ss:AutoFitWidth="0" ss:Width="105"/><Column ss:AutoFitWidth="0" ss:Width="130"/><Column ss:AutoFitWidth="0" ss:Width="200"/><Column ss:AutoFitWidth="0" ss:Width="100"/><Column ss:AutoFitWidth="0" ss:Width="120"/><Column ss:AutoFitWidth="0" ss:Width="190"/><Column ss:AutoFitWidth="0" ss:Width="150"/><Row><Cell ss:StyleID="head"><Data ss:Type="String">NOM ET PRÉNOMS</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">SEXE</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">DATE DE NAISSANCE</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">LIEU DE NAISSANCE</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">NOM DU PARENT / TUTEUR</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">LIEN DE PARENTÉ</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">TÉLÉPHONE DU PARENT</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">E-MAIL DU PARENT</Data></Cell><Cell ss:StyleID="head"><Data ss:Type="String">MATRICULE (laisser vide)</Data></Cell></Row><Row><Cell ss:StyleID="hint"><Data ss:Type="String">MBALLA Jean Pierre</Data></Cell><Cell ss:StyleID="hint"><Data ss:Type="String">M</Data></Cell><Cell ss:StyleID="hint"><Data ss:Type="String">12/03/2013</Data></Cell><Cell ss:StyleID="hint"><Data ss:Type="String">Douala</Data></Cell><Cell ss:StyleID="hint"><Data ss:Type="String">MBALLA Étienne</Data></Cell><Cell ss:StyleID="hint"><Data ss:Type="String">Père</Data></Cell><Cell ss:StyleID="hint"><Data ss:Type="String">6 99 00 11 22</Data></Cell><Cell ss:StyleID="hint"><Data ss:Type="String">parent@exemple.cm</Data></Cell><Cell ss:StyleID="hint"><Data ss:Type="String">attribué par le logiciel</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Mode d emploi"><Table><Row><Cell ss:StyleID="head"><Data ss:Type="String">Comment remplir ce fichier</Data></Cell></Row><Row><Cell><Data ss:Type="String">1. Ne modifiez pas la feuille « Eleves » : les colonnes sont déjà prêtes.</Data></Cell></Row><Row><Cell><Data ss:Type="String">2. Un élève par ligne, en commençant par le nom et les prénoms.</Data></Cell></Row><Row><Cell><Data ss:Type="String">3. Le matricule est attribué par le logiciel : laissez la colonne vide.</Data></Cell></Row><Row><Cell><Data ss:Type="String">4. La date de naissance s’écrit 12/03/2013 (ou 2013-03-12).</Data></Cell></Row><Row><Cell><Data ss:Type="String">5. Le sexe s’écrit M ou F (Masculin / Féminin acceptés).</Data></Cell></Row><Row><Cell><Data ss:Type="String">6. Enregistrez au format .xls (comme le modèle) puis importez ce fichier.</Data></Cell></Row><Row><Cell><Data ss:Type="String">7. Si Excel propose un autre format, choisissez « Classeur Excel 97-2003 ».</Data></Cell></Row></Table></Worksheet></Workbook>